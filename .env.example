# Copy this file to .env and fill only the values you want to use.

# none, ollama, or openai
JARVIS_LLM_PROVIDER=none

# Local LLM through Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Cloud LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Personal assistant identity
JARVIS_USER_NAME=Arpit
JARVIS_ASSISTANT_NAME=Jarvis
